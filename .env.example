# FleetOS — CodeVertex Core integration (Vite: prefix with VITE_)

VITE_APP_CODE=FLEETOS
VITE_ECOSYSTEM_CODE=codevertex
VITE_APP_BASE_URL=http://localhost:5173

VITE_AUTH_BASE_URL=https://auth.codevertex.cc

# Auth Core SSO consume (required for real SSO outside dev mock)
# Example: https://auth.codevertex.cc/functions/v1/consume-sso-ticket
# VITE_AUTH_SSO_CONSUME_URL=
VITE_BILLING_BASE_URL=https://billing.codevertex.cc
VITE_HELP_BASE_URL=https://help.codevertex.cc
VITE_LEGAL_BASE_URL=https://legal.codevertex.cc

# FleetOS operational Supabase (Phase 2+)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 6 — Edge functions (optional overrides; default: {VITE_SUPABASE_URL}/functions/v1/<name>)
# VITE_FLEETOS_SYNC_IDENTITY_URL=
# VITE_FLEETOS_LIST_TENANTS_URL=

# Supabase Edge secrets (Dashboard → Edge Functions → Secrets; never commit):
# - SUPABASE_SERVICE_ROLE_KEY — service_role JWT for PostgREST admin client inside Edge only
# - CODEVERTEX_JWKS_URI — Auth Core JWKS URL for RS256 verification
# - CODEVERTEX_JWT_ISSUER — expected JWT iss
# - CODEVERTEX_JWT_AUDIENCE — expected JWT aud
# - FLEETOS_ALLOWED_ORIGINS — comma-separated browser Origins allowed for CORS (e.g. https://app.fleetos.app,http://localhost:5173)

# Optional: tenant UUID on Auth Core membership mock (dev SSO mock only — no DB sync until Edge verifies token)
# VITE_FLEETOS_DEV_MOCK_TENANT_ID=

# CLI / migrations only (gitignored in .env.local — never commit)
# SUPABASE_DB_PASSWORD=

# FleetOS — CodeVertex Core integration (Vite: prefix with VITE_)

VITE_APP_CODE=FLEETOS
VITE_ECOSYSTEM_CODE=codevertex
VITE_APP_BASE_URL=http://localhost:5173

VITE_AUTH_BASE_URL=https://auth.codevertex.cc

# Auth Core SSO consume (required for real SSO outside dev mock)
# Example: https://auth.codevertex.cc/functions/v1/consume-sso-ticket
# VITE_AUTH_SSO_CONSUME_URL=
VITE_BILLING_BASE_URL=https://billing.codevertex.cc
VITE_HELP_BASE_URL=https://help.codevertex.cc
VITE_LEGAL_BASE_URL=https://legal.codevertex.cc

# FleetOS operational Supabase (Phase 2+)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CLI / migrations only (gitignored in .env.local — never commit)
# SUPABASE_DB_PASSWORD=
